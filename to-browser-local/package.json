{
  "name": "@noy-db/to-browser-local",
  "version": "0.8.0",
  "description": "localStorage adapter for noy-db with optional key obfuscation",
  "license": "Apache-2.0",
  "author": "vLannaAi <vicio@lanna.ai>",
  "homepage": "https://github.com/noy-db/to/tree/main/to-browser-local#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noy-db/to.git",
    "directory": "to-browser-local"
  },
  "bugs": {
    "url": "https://github.com/noy-db/to/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "peerDependencies": {
    "@noy-db/hub": "^0.6.0-pre.0 || ^0.7.0-pre.0 || ^0.7.1-pre.0 || ^0.8.0-pre.0"
  },
  "devDependencies": {
    "@noy-db/hub": "0.8.0",
    "@noy-db/test-adapter-conformance": "0.8.0",
    "happy-dom": "^18.0.0"
  },
  "keywords": [
    "noy-db",
    "adapter",
    "browser",
    "localstorage",
    "web",
    "offline-first",
    "encryption",
    "zero-knowledge",
    "obfuscation"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
