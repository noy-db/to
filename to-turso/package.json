{
  "name": "@noy-db/to-turso",
  "version": "0.7.0-pre.1",
  "description": "Turso / libSQL adapter for noy-db — edge SQLite with built-in replication. Wraps @libsql/client through a small async shim that speaks the same noy-db store contract as @noy-db/to-sqlite.",
  "license": "MIT",
  "author": "vLannaAi <vicio@lanna.ai>",
  "homepage": "https://github.com/noy-db/to/tree/main/to-turso#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noy-db/to.git",
    "directory": "to-turso"
  },
  "bugs": {
    "url": "https://github.com/noy-db/to/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@noy-db/hub": "^0.6.0-pre.0 || ^0.7.0-pre.0 || ^0.7.1-pre.0"
  },
  "devDependencies": {
    "@noy-db/hub": "0.7.0-pre.2",
    "@types/node": "^22.0.0",
    "@noy-db/test-adapter-conformance": "0.7.0-pre.2"
  },
  "keywords": [
    "noy-db",
    "to-turso",
    "turso",
    "libsql",
    "sqlite",
    "edge",
    "storage"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
