{
  "name": "@noy-db/to-sqlite",
  "version": "0.8.0",
  "description": "SQLite adapter for noy-db — single-file local encrypted document store. Works with better-sqlite3, node:sqlite (Node 22+), or bun:sqlite via a duck-typed Database interface. casAtomic: true (BEGIN IMMEDIATE + UPDATE WHERE _v=?).",
  "license": "Apache-2.0",
  "author": "vLannaAi <vicio@lanna.ai>",
  "homepage": "https://github.com/noy-db/to/tree/main/to-sqlite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noy-db/to.git",
    "directory": "to-sqlite"
  },
  "bugs": {
    "url": "https://github.com/noy-db/to/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@noy-db/hub": "^0.6.0-pre.0 || ^0.7.0-pre.0 || ^0.7.1-pre.0 || ^0.8.0-pre.0"
  },
  "devDependencies": {
    "@noy-db/hub": "0.8.0",
    "@types/node": "^22.0.0",
    "@noy-db/test-adapter-conformance": "0.8.0"
  },
  "keywords": [
    "noy-db",
    "to-sqlite",
    "sqlite",
    "storage",
    "encryption",
    "zero-knowledge"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
