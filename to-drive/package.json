{
  "name": "@noy-db/to-drive",
  "version": "0.8.1",
  "description": "Google Drive bundle store for noy-db. Stores the whole vault as a single .noydb file in Drive's hidden appDataFolder; opaque ULID filenames never leak compartment names. Driver-agnostic — bring your own OAuth token.",
  "license": "Apache-2.0",
  "author": "vLannaAi <vicio@lanna.ai>",
  "homepage": "https://github.com/noy-db/to/tree/main/to-drive#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noy-db/to.git",
    "directory": "to-drive"
  },
  "bugs": {
    "url": "https://github.com/noy-db/to/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "peerDependencies": {
    "@noy-db/hub": "^0.6.0-pre.11 || ^0.7.0-pre.0 || ^0.7.1-pre.0 || ^0.8.0-pre.0"
  },
  "devDependencies": {
    "@noy-db/hub": "0.8.0",
    "@types/node": "^22.0.0",
    "@noy-db/test-adapter-conformance": "0.8.0"
  },
  "keywords": [
    "noy-db",
    "to-drive",
    "google-drive",
    "oauth",
    "bundle",
    "storage",
    "zero-knowledge"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
