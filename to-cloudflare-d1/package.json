{
  "name": "@noy-db/to-cloudflare-d1",
  "version": "0.8.1",
  "description": "Cloudflare D1 adapter for noy-db — SQLite at the edge, running inside Cloudflare Workers. Accepts a D1Database binding and speaks the noy-db store contract via D1's prepare/bind API.",
  "license": "Apache-2.0",
  "author": "vLannaAi <vicio@lanna.ai>",
  "homepage": "https://github.com/noy-db/to/tree/main/to-cloudflare-d1#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noy-db/to.git",
    "directory": "to-cloudflare-d1"
  },
  "bugs": {
    "url": "https://github.com/noy-db/to/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "peerDependencies": {
    "@noy-db/hub": "^0.6.0-pre.0 || ^0.7.0-pre.0 || ^0.7.1-pre.0 || ^0.8.0-pre.0"
  },
  "devDependencies": {
    "@noy-db/hub": "0.8.0",
    "@types/node": "^22.0.0",
    "@noy-db/test-adapter-conformance": "0.8.0"
  },
  "keywords": [
    "noy-db",
    "to-cloudflare-d1",
    "cloudflare",
    "d1",
    "sqlite",
    "edge",
    "workers"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
